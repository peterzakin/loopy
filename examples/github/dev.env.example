# Template for the github example's `Dev` sandbox env_file.
#
#   cp dev.env.example secrets/dev.env   # secrets/ is gitignored — never commit the real one
#
# Injected into the sandbox as environment variables at run time. Lines are KEY=VALUE; no
# ${VAR} interpolation (values are literal).

# --- model auth (claude-code) ---
# Required for the docker sandbox (the image carries no creds).
ANTHROPIC_API_KEY=sk-ant-...

# --- git auth ---
# Only needed if you are NOT using a GitHub App. `loopy auth github` injects a scoped token
# automatically; otherwise supply a PAT with contents:read + pull_requests:write on the repo.
# GITHUB_TOKEN=ghp_...
