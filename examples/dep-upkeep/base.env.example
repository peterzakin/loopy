# Copy to secrets/base.env (the gitignored path registry.yml's env_file references) and fill in.
# Injected into the sandbox as environment variables at run time.

# The model key for the claude-code harness.
ANTHROPIC_API_KEY=sk-ant-...

# Git auth to push a branch and open a PR. Only needed if you are NOT using a GitHub App
# (`loopy auth github` injects a scoped token automatically). The token needs
# contents:write + pull_requests:write.
# GITHUB_TOKEN=ghp_...
