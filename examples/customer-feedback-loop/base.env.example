# Template for the customer-feedback-loop example's `BaseSandbox` env_file.
#
#   cp base.env.example secrets/base.env   # secrets/ is gitignored — never commit the real one
#
# Injected into the sandbox as environment variables at run time. Lines are KEY=VALUE; no
# ${VAR} interpolation (values are literal).

# --- model auth (claude-code) ---
# Required for the daytona sandbox (the image carries no creds).
ANTHROPIC_API_KEY=sk-ant-...

# --- git auth ---
# Only needed if you are NOT using a GitHub App. `loopy auth github` injects a scoped token
# automatically; otherwise supply a PAT with contents:write + pull_requests:write on the
# repo (the agent opens a PR when a ticket warrants work).
# GITHUB_TOKEN=ghp_...
