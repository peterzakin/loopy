{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Loopy engine host: one EC2 instance running the redis+loopy stack behind CloudFront (managed TLS on *.cloudfront.net, no operator domain). Agents run in Daytona, not here. Driven by `loopy deploy aws` (see docs/design/aws-deploy.md); the CLI injects the instance UserData before create/update.",
  "Parameters": {
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "Description": "Engine instance size. One instance only: the engine is a single SQLite writer."
    },
    "StateVolumeSizeGiB": {
      "Type": "Number",
      "Default": 8,
      "MinValue": 1,
      "Description": "EBS data volume mounted at /state (SQLite run history + redis append-only file)."
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
      "Description": "Resolved via AWS's public SSM parameter so the template never pins a per-region AMI."
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "Description": "The com.amazonaws.global.cloudfront.origin-facing managed prefix list id for this region (looked up by the CLI). Only CloudFront's origin-facing ranges may reach the engine port."
    },
    "OriginDomain": {
      "Type": "String",
      "Default": "",
      "Description": "The instance's EIP public DNS name, filled by the CLI on the second pass (CloudFront origins need a DNS name, and the EIP's name is only known after the first pass). Empty = no distribution yet."
    },
    "EnginePort": {
      "Type": "Number",
      "Default": 8000,
      "Description": "The port the engine container publishes on the instance; CloudFront's origin port."
    }
  },
  "Conditions": {
    "HasOrigin": {
      "Fn::Not": [{ "Fn::Equals": [{ "Ref": "OriginDomain" }, ""] }]
    }
  },
  "Resources": {
    "EngineSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Loopy engine origin: inbound only from CloudFront's origin-facing ranges. The EIP is a locked-down origin, not a second public door.",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": { "Ref": "EnginePort" },
            "ToPort": { "Ref": "EnginePort" },
            "SourcePrefixListId": { "Ref": "CloudFrontPrefixListId" }
          }
        ],
        "Tags": [{ "Key": "loopy:stack", "Value": { "Ref": "AWS::StackName" } }]
      }
    },
    "EngineRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "ec2.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "loopy-engine-boot",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadStackSecrets",
                  "Effect": "Allow",
                  "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/loopy/${AWS::StackName}/*"
                  }
                },
                {
                  "Sid": "DecryptStackSecrets",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": { "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com" }
                    }
                  }
                },
                {
                  "Sid": "FetchProjectTarball",
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::loopy-deploy-${AWS::AccountId}-${AWS::Region}/${AWS::StackName}/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [{ "Key": "loopy:stack", "Value": { "Ref": "AWS::StackName" } }]
      }
    },
    "EngineInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": [{ "Ref": "EngineRole" }] }
    },
    "EngineInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": { "Ref": "AmiId" },
        "InstanceType": { "Ref": "InstanceType" },
        "IamInstanceProfile": { "Ref": "EngineInstanceProfile" },
        "SecurityGroupIds": [{ "Fn::GetAtt": ["EngineSecurityGroup", "GroupId"] }],
        "UserData": { "Fn::Base64": "__LOOPY_USER_DATA__" },
        "Tags": [
          { "Key": "Name", "Value": { "Fn::Sub": "${AWS::StackName}-engine" } },
          { "Key": "loopy:stack", "Value": { "Ref": "AWS::StackName" } }
        ]
      }
    },
    "EngineAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [{ "Key": "loopy:stack", "Value": { "Ref": "AWS::StackName" } }]
      }
    },
    "EngineAddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": ["EngineAddress", "AllocationId"] },
        "InstanceId": { "Ref": "EngineInstance" }
      }
    },
    "StateVolume": {
      "Type": "AWS::EC2::Volume",
      "Properties": {
        "AvailabilityZone": { "Fn::GetAtt": ["EngineInstance", "AvailabilityZone"] },
        "Size": { "Ref": "StateVolumeSizeGiB" },
        "VolumeType": "gp3",
        "Tags": [{ "Key": "loopy:stack", "Value": { "Ref": "AWS::StackName" } }]
      }
    },
    "StateVolumeAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": { "Ref": "EngineInstance" },
        "VolumeId": { "Ref": "StateVolume" }
      }
    },
    "BlockAdminFunction": {
      "Type": "AWS::CloudFront::Function",
      "Condition": "HasOrigin",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}-block-admin" },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Refuse /admin* at the edge: on the no-domain mode the CloudFront->origin hop is plain HTTP, so the dashboard's bearer token must not travel it. Reach /admin over an SSM tunnel instead.",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var uri = event.request.uri;\n  if (uri === '/admin' || uri.indexOf('/admin/') === 0) {\n    return { statusCode: 403, statusDescription: 'Forbidden', headers: { 'content-type': { value: 'text/plain' } }, body: 'The dashboard is not served publicly on this deployment. Reach it over an SSM tunnel: loopy admin --remote (see docs/deployment).' };\n  }\n  return event.request;\n}\n"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Condition": "HasOrigin",
      "DependsOn": "EngineAddressAssociation",
      "Properties": {
        "DistributionConfig": {
          "Comment": { "Fn::Sub": "Loopy engine front door for ${AWS::StackName}: managed cert, no caching, all methods+headers forwarded so webhook POSTs and signatures arrive intact." },
          "Enabled": true,
          "HttpVersion": "http2",
          "Origins": [
            {
              "Id": "loopy-engine",
              "DomainName": { "Ref": "OriginDomain" },
              "CustomOriginConfig": {
                "HTTPPort": { "Ref": "EnginePort" },
                "OriginProtocolPolicy": "http-only"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "loopy-engine",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "POST", "PATCH", "DELETE"],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": { "Fn::GetAtt": ["BlockAdminFunction", "FunctionARN"] }
              }
            ]
          },
          "ViewerCertificate": { "CloudFrontDefaultCertificate": true }
        },
        "Tags": [{ "Key": "loopy:stack", "Value": { "Ref": "AWS::StackName" } }]
      }
    }
  },
  "Outputs": {
    "PublicIp": {
      "Description": "The engine's Elastic IP (the CloudFront origin; direct traffic is refused by the security group).",
      "Value": { "Fn::GetAtt": ["EngineAddress", "PublicIp"] }
    },
    "InstanceId": {
      "Description": "The engine instance (reachable via SSM Session Manager; no SSH port is open).",
      "Value": { "Ref": "EngineInstance" }
    },
    "DistributionDomain": {
      "Condition": "HasOrigin",
      "Description": "The public HTTPS hostname webhooks target; LOOPY_PUBLIC_URL is https:// this.",
      "Value": { "Fn::GetAtt": ["Distribution", "DomainName"] }
    }
  }
}
