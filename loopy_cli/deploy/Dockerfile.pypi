# Internal deployment asset — built by `loopy run` (container mode) when there is NO loopy
# source checkout (e.g. a `pip install loopy-computer`). Installs the pinned loopy release straight
# from PyPI, so it needs no build context beyond this file — that's what removes the
# source-checkout requirement from container mode.
#
# The engine image: the single long-lived process `loopy run` drives — sensor webhooks
# + scheduler + event-bus consumer + runtime, all in one. Agents do NOT run here; they
# run in Daytona sandboxes (a separate domain).
FROM python:3.12-slim

# The loopy release to install — supplied by the CLI as a build arg (its own version), so the
# engine image always matches the CLI that launched it. Fail loudly if it wasn't passed.
ARG LOOPY_VERSION
RUN test -n "$LOOPY_VERSION" || (echo "LOOPY_VERSION build arg is required" >&2; exit 1)

# [redis] for `--bus redis`, [tenki] for `provider: tenki` sandboxes; Daytona (the default
# sandbox) ships in the core deps.
RUN pip install --no-cache-dir "loopy-computer[redis,tenki]==${LOOPY_VERSION}"

# Commands run against the bind-mounted project (manifest + sensors + env files).
WORKDIR /project

ENTRYPOINT ["loopy"]
