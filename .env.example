# Copy to `.env` (gitignored) and fill in. Read by docker compose for variable
# substitution in docker-compose.yml.

# Host path to your compiled Loopy project (the dir holding manifest.json, sensors/,
# registry.yml, and any env files). Mounted read-only into the engine at /project.
LOOPY_PROJECT=./project

# Manifest filename within the project (produced by `loopy compile`).
LOOPY_MANIFEST=manifest.json

# Host port to expose the sensor-webhook server on.
LOOPY_PORT=8000

# Daytona — the agent sandbox. Required for --sandbox daytona.
DAYTONA_API_KEY=
# Optional; defaults to Daytona's hosted API when unset.
DAYTONA_API_URL=
